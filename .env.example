# ====== Backend (server/) ======

# Porta do backend proxy + API
PORT=3001

# ID do recurso CKAN do dataset de tarifas residenciais da ANEEL.
# Pode mudar quando a ANEEL re-publica o dataset — checar em:
# https://dadosabertos.aneel.gov.br/dataset/tarifas-homologadas-das-distribuidoras-de-energia-eletrica
ANEEL_RESOURCE_ID=fcf2906c-7c32-4b9b-a637-054e7a5234f4

# ====== Banco de dados ======
# Apontar para o Postgres do docker-compose por padrão.
DATABASE_URL=postgres://energytrack:energytrack@localhost:5432/energytrack

# ====== Autenticação ======
# Segredo para assinar JWTs. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-em-producao-por-um-aleatorio-de-no-minimo-32-bytes
JWT_EXPIRES_IN=7d

# Google Identity Services — obter no Google Cloud Console (APIs & Services > Credentials).
# Tipo: OAuth 2.0 Client ID > Web application > Authorized JavaScript origins: http://localhost:5173
GOOGLE_CLIENT_ID=

# ====== Frontend ======
# (lidas pelo Vite — devem começar com VITE_)
VITE_GOOGLE_CLIENT_ID=
