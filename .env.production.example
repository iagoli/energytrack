# ============================================================
# EnergyTrack — variáveis de PRODUÇÃO (Vercel + Render + Supabase)
# Copie para .env e PREENCHA com os valores reais. NUNCA commite .env.
# ============================================================

# ---- Backend (Render) ----
# Porta: o Render injeta PORT automaticamente; deixe 3001 como fallback.
PORT=3001

# DATABASE_URL do Supabase (painel -> Project Settings -> Database -> Connection string -> URI)
# Ex.: postgresql://postgres.[projeto]:[senha]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# IMPORTANTE: o pool.js habilita SSL automaticamente quando a URL contém "supabase".
DATABASE_URL=postgresql://postgres:SUA_SENHA@SEU_HOST_SUPABASE:5432/postgres

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use um segredo FORTE e ÚNICO em produção.
JWT_SECRET=TROQUE_POR_UM_SEGREDO_FORTE_ALEATORIO_DE_64_HEX

# Duração do token (opcional, padrão 7d)
JWT_EXPIRES_IN=7d

# Client ID do Google OAuth (opcional). Deixe vazio para desabilitar login Google.
# Obtenha no Google Cloud Console e adicione o domínio de produção em
# "Authorized JavaScript origins" (ex.: https://energytrack.vercel.app).
GOOGLE_CLIENT_ID=

# Resource ID do dataset CKAN de tarifas ANEEL (raramente muda).
ANEEL_RESOURCE_ID=fcf2906c-7c32-4b9b-a637-054e7a5234f4

# Origem do frontend permitida no CORS (domínio da Vercel).
# Ex.: https://energytrack.vercel.app
ALLOWED_ORIGIN=

# ---- Frontend (Vercel, prefixo VITE_) ----
# Mesmo Client ID do Google, exposto ao browser. Deixe vazio se não usar Google.
VITE_GOOGLE_CLIENT_ID=
